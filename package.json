{
  "name": "devdoctor-ai",
  "version": "1.0.0",
  "description": "An open-weight multimodal AI debugging assistant that analyzes software error screenshots, explains likely causes, and provides step-by-step troubleshooting guidance.",
  "author": "Bharatwajverse",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bharathwajverse/devdoctor-ai.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "tsx src/backend/server.ts",
    "start": "tsx src/backend/server.ts",
    "build": "tsc -b && vite build",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vitest": "^1.3.1"
  }
}
