# ==============================================================================
# devdoctor-ai Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed.
# NEVER commit your real .env file or real credentials to Git!

# Server Configuration
PORT=3001
HOST=localhost
NODE_ENV=development

# AI Model Provider Selection
# Options: "ollama" (default local open-weight) | "google" (Gemini/Gemma API) | "demo" (deterministic offline sample)
MODEL_PROVIDER=ollama

# Ollama Configuration (Local Open-Weight Multimodal Model)
# Default model: paligemma2:3b, paligemma:3b, llava:7b, or gemma2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=paligemma:3b
OLLAMA_TIMEOUT_MS=60000

# Google AI Studio / Gemini API (Optional Fallback / Alternative Provider)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# HuggingFace Inference API (Optional Alternative)
HF_API_TOKEN=
HF_MODEL_ID=google/paligemma-3b-pt-224

# Demo Mode Fallback
# When true or when live models are unreachable, returns high-fidelity annotated sample analyses
# clearly watermarked as "[DEMO / SAMPLE DATA - NO LIVE MODEL CONNECTED]"
ENABLE_DEMO_FALLBACK=true

# Security & Upload Constraints
MAX_IMAGE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp

# Logging
LOG_LEVEL=info
